NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed locally to run `npm run create-admin`. Never expose this to the
# browser (no NEXT_PUBLIC_ prefix) and never commit it — it bypasses every
# database access rule. Get it from Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Only needed locally to run `npm run db:migrate` (applies the SQL in
# supabase/migrations + supabase/seed*.sql directly via Prisma). Use the
# "Session pooler" connection string from Project Settings -> Database, not
# the "URI" direct connection — the direct host is IPv6-only and won't
# resolve on IPv4-only networks.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
